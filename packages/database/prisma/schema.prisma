datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

model Tenant {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  users       User[]
  roles       Role[]
  permissions Permission[]
  sessions    Session[]
  invites     InviteToken[]

  @@index([deletedAt])
}

model User {
  id                    String              @id @default(uuid())
  tenantId              String
  tenant                Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  email                 String
  firstName             String
  lastName              String
  fullName              String
  passwordHash          String?
  isActive              Boolean             @default(true)
  lastLoginAt           DateTime?
  deactivatedAt         DateTime?
  deactivatedBy         String?
  deletedAt             DateTime?
  createdBy             String?
  updatedBy             String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  roles                 UserRole[]
  sessions              Session[]
  resetTokens           PasswordResetToken[]
  revokedTokens         RevokedToken[]
  invitesCreated        InviteToken[]       @relation("inviteCreator")
  invitesReceived       InviteToken[]       @relation("inviteUser")
  permissionOverrides   UserPermission[]

  @@unique([tenantId, email])
  @@index([tenantId, isActive])
  @@index([deletedAt])
}

model Role {
  id          String           @id @default(uuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name        String
  description String?
  isSystem    Boolean          @default(false)
  deletedAt   DateTime?
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([deletedAt])
}

model Permission {
  id          String           @id @default(uuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  code        String
  name        String
  description String?
  deletedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]
  userOverrides UserPermission[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([deletedAt])
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  createdBy String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  createdBy    String?
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model Session {
  id                 String        @id @default(uuid())
  tenantId           String
  userId             String
  refreshTokenHash   String
  userAgent          String?
  ipAddress          String?
  expiresAt          DateTime
  lastActivityAt     DateTime      @default(now())
  revokedAt          DateTime?
  status             SessionStatus @default(ACTIVE)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([tenantId, status])
  @@index([expiresAt])
}

model PasswordResetToken {
  id          String   @id @default(uuid())
  userId       String
  tokenHash    String
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model RevokedToken {
  id         String   @id @default(uuid())
  userId     String
  tokenJti   String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tokenJti])
  @@index([userId, expiresAt])
}

model InviteToken {
  id            String    @id @default(uuid())
  tenantId      String
  userId        String
  tokenHash     String
  invitedEmail  String
  expiresAt     DateTime
  acceptedAt    DateTime?
  revokedAt     DateTime?
  inviteSentBy  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user          User      @relation("inviteUser", fields: [userId], references: [id], onDelete: Cascade)
  sentByUser    User?     @relation("inviteCreator", fields: [inviteSentBy], references: [id], onDelete: SetNull)

  @@index([tenantId, invitedEmail])
  @@index([expiresAt])
}

model UserPermission {
  id            String      @id @default(uuid())
  userId        String
  permissionId  String
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission    Permission  @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([permissionId])
}
