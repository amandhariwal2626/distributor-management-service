datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum RoleCode {
  SUPER_ADMIN
  COMPANY_ADMIN
  DISTRIBUTOR
  SALESPERSON
  RETAILER
  WAREHOUSE_MANAGER
  ACCOUNTS
}

model Tenant {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  users       User[]
  roles       Role[]
  permissions Permission[]
  sessions    Session[]

  @@index([deletedAt])
}

model User {
  id             String              @id @default(cuid())
  tenantId       String
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  email          String
  passwordHash   String
  fullName       String
  status         UserStatus          @default(ACTIVE)
  lastLoginAt    DateTime?
  deletedAt      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  roles          UserRole[]
  sessions       Session[]
  resetTokens    PasswordResetToken[]
  revokedTokens  RevokedToken[]

  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@index([deletedAt])
}

model Role {
  id          String           @id @default(cuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  code        RoleCode
  name        String
  isSystem    Boolean          @default(false)
  deletedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([deletedAt])
}

model Permission {
  id          String           @id @default(cuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  code        String
  name        String
  deletedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([deletedAt])
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model Session {
  id                 String        @id @default(cuid())
  tenantId           String
  userId             String
  refreshTokenHash   String
  userAgent          String?
  ipAddress          String?
  expiresAt          DateTime
  lastActivityAt     DateTime      @default(now())
  revokedAt          DateTime?
  status             SessionStatus @default(ACTIVE)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([tenantId, status])
  @@index([expiresAt])
}

model PasswordResetToken {
  id          String   @id @default(cuid())
  userId       String
  tokenHash    String
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model RevokedToken {
  id         String   @id @default(cuid())
  userId     String
  tokenJti   String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tokenJti])
  @@index([userId, expiresAt])
}
