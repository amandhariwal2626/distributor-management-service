# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dms?schema=public"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dms

# Backend Configuration
PORT=3001
CORS_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=replace-with-long-secret
JWT_REFRESH_TTL_DAYS=7
INVITE_TOKEN_TTL_HOURS=72

# S3 / Storage Configuration (optional - falls back to local disk)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=dms-uploads

# Redis Configuration (optional - for BullMQ background jobs)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001
