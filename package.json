{
  "name": "dms-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "db:migrate": "npm run db:migrate --workspace=@dms/database",
    "db:generate": "npm run db:generate --workspace=@dms/database",
    "db:studio": "npm run db:studio --workspace=@dms/database",
    "db:seed": "npm run db:seed --workspace=@dms/database",
    "postinstall": "npm run build -w @dms/database"
  },
  "devDependencies": {
    "prettier": "^3.8.3"
  },
  "dependencies": {
    "next-themes": "^0.4.6",
    "prisma": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "turbo": "^2.9.16"
  },
  "overrides": {
    "glob": "^10.5.0",
    "lodash": "^4.18.1",
    "postcss": "^8.5.10",
    "tar": "^7.5.11"
  }
}
