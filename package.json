{
  "name": "dms-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.8.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "db:migrate": "npm run db:migrate --workspace=@dms/api",
    "db:generate": "npm run db:generate --workspace=@dms/api",
    "db:studio": "npm run db:studio --workspace=@dms/api"
  },
  "devDependencies": {
    "turbo": "^2.0.4",
    "prettier": "^3.2.5"
  }
}
